# ── Oncofiles MCP Server — Environment Variables ─────────────────────────────

# Anthropic API key (required for AI summaries, metadata extraction, OCR)
ANTHROPIC_API_KEY=

# SQLite database path (default: data/oncofiles.db)
# DATABASE_PATH=data/oncofiles.db

# ── Google Drive sync ────────────────────────────────────────────────────────
# Root folder ID in Google Drive
# GOOGLE_DRIVE_FOLDER_ID=
# Service account credentials (base64-encoded JSON). Optional, production uses OAuth only
# GOOGLE_CREDENTIALS_BASE64=
# Or path to credentials file (local dev)
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Google OAuth 2.0 (for user-context GDrive operations) ────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/oauth/callback

# ── Database: a local SQLite file on a persistent volume (DATABASE_PATH) ──────
# Turso/libsql support was removed (#617). Setting any TURSO_* variable makes
# the server refuse to start, so no env var can route PHI to a cloud DB.

# ── MCP transport ────────────────────────────────────────────────────────────
# "stdio" for local CLI, "streamable-http" for cloud deployment
# MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_BEARER_TOKEN=  # optional static token for dev/testing

# ── Patient context ──────────────────────────────────────────────────────────
# Stored per patient in the DB (patient_context table), set via the
# update_patient_context MCP tool. patient_context.example.json shows the shape.
# PATIENT_CONTEXT_PATH and PATIENT_NAME are no longer read (#733).

# ── Sync scheduler ──────────────────────────────────────────────────────────
# SYNC_INTERVAL_MINUTES=30
# SYNC_ENABLED=true

# ── Localization ─────────────────────────────────────────────────────────────
# ONCOFILES_PREFERRED_LANG=sk

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Outgoing e-mail (SMTP, #834) ────────────────────────────────────────────
# Unset SMTP_HOST or MAIL_FROM = no e-mail is sent (one WARNING per attempt).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587            # STARTTLS; 465 (or SMTP_SSL=true) = implicit TLS
# SMTP_USER=
# SMTP_PASSWORD=           # runtime secret, never commit
# MAIL_FROM=Oncofiles <noreply@oncofiles.com>
# MAIL_REPLY_TO=           # a read inbox: unsubscribe is a reply
# NOTIFY_TO_EMAIL=         # admin alerts, comma-separated
